
(async () => {
  try {
    const get = async (url) => {
      const r = await fetch(url);
      if (!r.ok) throw new Error(`${url}: HTTP ${r.status}`);
      return r.json();
    };

    const db = await get(
      '/apis/dashboard.grafana.app/v1/namespaces/default/dashboards?limit=1000'
    );

    const search = await get(
      '/api/search?type=dash-db&limit=5000'
    );

    if (!Array.isArray(db.items) || !Array.isArray(search)) {
      throw new Error('Неожиданный формат ответа API');
    }

    if (db.metadata?.continue) {
      throw new Error('Есть следующая страница дашбордов');
    }

    const indexed = new Set(search.map(x => x.uid));

    const missing = db.items
      .map(x => ({
        title: x.spec?.title,
        uid: x.metadata?.name
      }))
      .filter(x => !indexed.has(x.uid));

    console.log('В хранилище:', db.items.length);
    console.log('В поиске:', search.length);
    console.log('Не отображаются:', missing.length);
    console.table(missing);

  } catch (e) {
    console.error('Ошибка проверки:', e);
  }
})();




WITH old_dashboards AS (
    SELECT
        d.org_id,
        d.uid,
        d.title,
        d.updated,
        CASE
            WHEN d.org_id = 1 THEN 'default'
            ELSE 'org-' || CAST(d.org_id AS TEXT)
        END AS namespace
    FROM public.dashboard AS d
    WHERE d.is_folder = FALSE
)
SELECT
    d.org_id,
    d.uid,
    d.title,
    d.updated
FROM old_dashboards AS d
WHERE NOT EXISTS (
    SELECT 1
    FROM public.resource AS r
    WHERE r."group" = 'dashboard.grafana.app'
      AND r.resource = 'dashboards'
      AND r.namespace = d.namespace
      AND r.name = d.uid
)
ORDER BY d.org_id, d.title;


SELECT 'OLD' AS storage, COUNT(*) AS dashboards
FROM public.dashboard
WHERE is_folder = FALSE

UNION ALL

SELECT 'NEW' AS storage, COUNT(*) AS dashboards
FROM public.resource
WHERE "group" = 'dashboard.grafana.app'


SELECT
    d.org_id,
    d.title,
    d.uid,
    CASE
        WHEN r.name IS NULL THEN 'MISSING'
        ELSE 'PRESENT'
    END AS status
FROM public.dashboard d
LEFT JOIN public.resource r
    ON r."group" = 'dashboard.grafana.app'
   AND r.resource = 'dashboards'
   AND r.name = d.uid
   AND r.namespace = CASE
       WHEN d.org_id = 1 THEN 'default'
       ELSE 'org-' || d.org_id::text
   END
WHERE d.is_folder = FALSE
ORDER BY status, d.title;
  AND resource = 'dashboards';
