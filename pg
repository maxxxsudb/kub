SELECT format('ALTER TABLE dashboard.%I OWNER TO "crf-dashboard";', tablename) FROM pg_tables WHERE schemaname='dashboard' \gexec


SELECT format('ALTER TABLE public.%I OWNER TO %I;', n.tablename, o.tableowner) FROM pg_tables n JOIN pg_tables o USING (tablename) WHERE n.schemaname='public' AND o.schemaname='public_old' AND n.tableowner<>o.tableowner \gexec


-- ТАБЛИЦЫ
SELECT schemaname, tableowner, count(*) FROM pg_tables
WHERE schemaname IN ('public','dashboard','public_old','dashboard_old')
GROUP BY 1,2;

-- ПОСЛЕДОВАТЕЛЬНОСТИ
SELECT schemaname, sequenceowner, count(*) FROM pg_sequences
WHERE schemaname IN ('public','dashboard','public_old','dashboard_old')
GROUP BY 1,2;

-- ПРЕДСТАВЛЕНИЯ
SELECT schemaname, viewowner, count(*) FROM pg_views
WHERE schemaname IN ('public','dashboard','public_old','dashboard_old')
GROUP BY 1,2;

-- МАТЕРИАЛИЗОВАННЫЕ ПРЕДСТАВЛЕНИЯ
SELECT schemaname, matviewowner, count(*) FROM pg_matviews
WHERE schemaname IN ('public','dashboard','public_old','dashboard_old')
GROUP BY 1,2;

-- ФУНКЦИИ
SELECT pronamespace::regnamespace AS schema, pg_get_userbyid(proowner) AS owner, count(*)
FROM pg_proc
WHERE pronamespace::regnamespace::text IN ('public','dashboard','public_old','dashboard_old')
GROUP BY 1,2;
