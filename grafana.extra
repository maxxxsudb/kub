curl --fail --show-error \
  --user 'ВАШ_ЛОГИН' \
  --output plugin-test.zip \
  'https://git.my..com/rest/api/1.0/projects/plccs/repos/gitgrafana/raw/plugin.zip?at=refs%2Fheads%2Fqas'


grafana:
  extraContainerVolumes:
    - name: git-ca
      secret:
        secretName: grafana-bitbucket-ca

  extraInitContainers:
    - name: install-private-plugin
      image: registry.company.ru/tools/curl-unzip:VERSION
      command: ["/bin/sh", "-ec"]
      args:
        - |
          : "${GIT_URL:?}" "${GIT_BRANCH:?}" "${GIT_USER:?}" "${GIT_TOKEN:?}"

          BASE="${GIT_URL%%/scm/*}"
          REPO_PATH="${GIT_URL#*/scm/}"
          PROJECT="${REPO_PATH%%/*}"
          REPO="${REPO_PATH#*/}"
          REPO="${REPO%.git}"

          curl --fail --show-error --silent \
            --cacert /ca/root-ca.crt \
            --user "$GIT_USER:$GIT_TOKEN" \
            --get \
            --data-urlencode "at=refs/heads/$GIT_BRANCH" \
            "$BASE/rest/api/1.0/projects/$PROJECT/repos/$REPO/raw/plugin.zip" \
            --output /var/lib/grafana/plugin.zip

          mkdir -p /var/lib/grafana/plugins
          unzip -o /var/lib/grafana/plugin.zip \
            -d /var/lib/grafana/plugins
          rm /var/lib/grafana/plugin.zip

      envFrom:
        - secretRef:
            name: grafana-plugin-git-auth

      volumeMounts:
        - name: storage
          mountPath: /var/lib/grafana
        - name: git-ca
          mountPath: /ca
          readOnly: true
