#!/usr/bin/env bash
# На мастер-ноде только Bash/стандартные утилиты; Airflow CLI внутри pods.
# Отдельные Python-скрипты и команды python не используются.
# Только чтение: никаких apply/patch/delete/restart и записи объектов S3.
# Вывод сразу в терминал. Сам скрипт файлы отчёта не создаёт.
set -u
set +m

GOOD_POD=""
BAD_POD=""
NS=""                 # Пусто: однозначный поиск по GOOD_POD.
CONTAINER=""          # Пусто: стандартный выбор контейнера kubectl.
MINIO_HEALTH_URL=""   # Необязательно: http://host:9000/minio/health/live
SINCE="12h"
STEP_TIMEOUT=8       # Секунд на команду; затем принудительная остановка.
TOTAL_TIMEOUT=300     # Общий бюджет времени, включая ожидание команд.

ACTIVE_PID=""
CURRENT_STEP="инициализация"
FAILURES=0
START=$SECONDS

stop() {
    local code="$1"
    trap '' INT TERM
    printf '\nОСТАНОВКА: %s\n' "$CURRENT_STEP" >&2
    if [[ -n "$ACTIVE_PID" ]]; then
        # Только отдельная группа текущей диагностической команды.
        kill -TERM -- "-$ACTIVE_PID" 2>/dev/null || true
        kill -KILL -- "-$ACTIVE_PID" 2>/dev/null || true
        wait "$ACTIVE_PID" 2>/dev/null || true
    fi
    exit "$code"
}
trap 'stop 130' INT
trap 'stop 143' TERM

for dep in kubectl timeout setsid awk; do
    command -v "$dep" >/dev/null 2>&1 || {
        printf 'ERROR: не найдена команда %s\n' "$dep" >&2
        exit 1
    }
done
if [[ -z "$GOOD_POD" || -z "$BAD_POD" || "$GOOD_POD" == "$BAD_POD" ]]; then
    echo 'ERROR: заполните GOOD_POD и BAD_POD разными именами.' >&2
    exit 1
fi
if [[ ! "$STEP_TIMEOUT" =~ ^[1-9][0-9]*$ || ! "$TOTAL_TIMEOUT" =~ ^[1-9][0-9]*$ ]]; then
    echo 'ERROR: таймауты должны быть положительными целыми числами.' >&2
    exit 1
fi

run() {
    CURRENT_STEP="$1"
    shift
    local remaining=$((TOTAL_TIMEOUT - SECONDS + START))
    local limit="$STEP_TIMEOUT" rc
    if (( remaining <= 1 )); then
        echo 'Достигнут общий лимит времени.' >&2
        stop 124
    fi
    (( limit > remaining - 1 )) && limit=$((remaining - 1))
    printf '\n[%ss] >>> %s (лимит %ss)\n' "$((SECONDS - START))" "$CURRENT_STEP" "$limit" >&2
    printf '    ' >&2
    printf '%q ' "$@" >&2
    printf '\n' >&2
    # Отдельная группа: Ctrl+C не зависит от реакции kubectl на SIGINT.
    setsid timeout --signal=TERM --kill-after=1s "${limit}s" "$@" <&0 &
    ACTIVE_PID=$!
    wait "$ACTIVE_PID"
    rc=$?
    ACTIVE_PID=""
    case "$rc" in
        0) echo "<<< OK: $CURRENT_STEP" >&2 ;;
        124|137)
            echo "<<< TIMEOUT: $CURRENT_STEP" >&2
            FAILURES=$((FAILURES + 1)) ;;
        *)
            echo "<<< ERROR rc=$rc: $CURRENT_STEP" >&2
            FAILURES=$((FAILURES + 1)) ;;
    esac
    return "$rc"
}

echo 'Диагностика чтением. Ctrl+C — остановка. Никаких фоновых задач в pods.'
echo 'Python на мастер-ноде не нужен. Airflow CLI выполняется внутри pods.'
echo 'Исходные логи/ошибки могут содержать секреты; полный Connection JSON не печатается.'

if [[ -z "$NS" ]]; then
    # PID не прячется внутри $(...), поэтому trap видит активную команду.
    # Данные принимаются Bash coproc; запись временных файлов не нужна.
    CURRENT_STEP="поиск namespace"
    printf '\n>>> %s (лимит %ss)\n' "$CURRENT_STEP" "$STEP_TIMEOUT" >&2
    coproc NS_LOOKUP {
        exec setsid timeout --signal=TERM --kill-after=1s "${STEP_TIMEOUT}s" \
            kubectl --request-timeout=5s get pods -A \
            -o 'custom-columns=NS:.metadata.namespace,NAME:.metadata.name' --no-headers
    }
    ACTIVE_PID=$NS_LOOKUP_PID
    LOOKUP_PID=$ACTIVE_PID
    LOOKUP_FD=${NS_LOOKUP[0]}
    MATCHES=0
    while read -r namespace name <&"$LOOKUP_FD"; do
        if [[ "$name" == "$GOOD_POD" ]]; then
            NS="$namespace"
            MATCHES=$((MATCHES + 1))
        fi
    done
    wait "$LOOKUP_PID"
    rc=$?
    ACTIVE_PID=""
    exec {LOOKUP_FD}<&-
    if (( rc != 0 || MATCHES != 1 )); then
        printf 'ERROR: поиск namespace rc=%s, совпадений=%s. Заполните NS вручную.\n' "$rc" "$MATCHES" >&2
        exit 1
    fi
    echo "<<< OK: namespace=$NS"
fi

KUBE=(kubectl --request-timeout=5s)
run 'Проверка двух pods' "${KUBE[@]}" get pods -n "$NS" "$GOOD_POD" "$BAD_POD" -o wide || exit 1

for POD in "$GOOD_POD" "$BAD_POD"; do
    echo
    echo "================ $POD ================"
    run "$POD: контейнеры, образы, рестарты, узел" "${KUBE[@]}" get pod -n "$NS" "$POD" \
        -o 'jsonpath=Node: {.spec.nodeName}{"\n"}ServiceAccount: {.spec.serviceAccountName}{"\n"}Revision: {.metadata.labels.controller-revision-hash}{"\n"}{range .spec.containers[*]}Container: {.name} Image: {.image}{"\n"}{end}{range .status.containerStatuses[*]}Status: {.name} Ready: {.ready} Restarts: {.restartCount} ImageID: {.imageID}{"\n"}Last exit: {.lastState.terminated.exitCode} Reason: {.lastState.terminated.reason}{"\n"}{end}' || true

    run "$POD: ссылки env/Secret/ConfigMap и mounts, без значений секретов" "${KUBE[@]}" get pod -n "$NS" "$POD" \
        -o 'jsonpath={range .spec.containers[*]}Container: {.name}{"\n"}{range .env[*]}Env: {.name} Secret: {.valueFrom.secretKeyRef.name}/{.valueFrom.secretKeyRef.key} ConfigMap: {.valueFrom.configMapKeyRef.name}/{.valueFrom.configMapKeyRef.key}{"\n"}{end}{range .envFrom[*]}EnvFrom Secret: {.secretRef.name} ConfigMap: {.configMapRef.name}{"\n"}{end}{range .volumeMounts[*]}Mount: {.name} Path: {.mountPath} ReadOnly: {.readOnly}{"\n"}{end}{end}' || true

    EXEC=("${KUBE[@]}" exec -i -n "$NS" "$POD")
    LOGS=("${KUBE[@]}" logs -n "$NS" "$POD")
    if [[ -n "$CONTAINER" ]]; then
        EXEC+=(-c "$CONTAINER")
        LOGS+=(-c "$CONTAINER")
    fi

    # Каждый вызов Airflow имеет свой видимый шаг и отдельный таймаут.
    # В контейнере GNU timeout дополнительно ограничивает удалённый процесс.
    CLI_WRAPPER='if command -v timeout >/dev/null 2>&1 && timeout --version >/dev/null 2>&1; then exec timeout --signal=TERM --kill-after=1s 6s "$@"; else echo "WARNING: remote timeout unavailable; only local kubectl deadline applies" >&2; exec "$@"; fi'
    run "$POD: версия Airflow" "${EXEC[@]}" -- env PYTHONDONTWRITEBYTECODE=1 \
        sh -c "$CLI_WRAPPER" diag airflow version || true
    for KEY in remote_logging remote_log_conn_id remote_base_log_folder logging_config_class base_log_folder delete_local_logs task_log_reader; do
        run "$POD: effective logging.$KEY" "${EXEC[@]}" -- env PYTHONDONTWRITEBYTECODE=1 \
            sh -c "$CLI_WRAPPER" diag airflow config get-value logging "$KEY" || true
    done
    run "$POD: Secrets backend" "${EXEC[@]}" -- env PYTHONDONTWRITEBYTECODE=1 \
        sh -c "$CLI_WRAPPER" diag airflow config get-value secrets backend || true

    run "$POD: фактический remote-log Connection, секретные поля скрыты" \
        "${EXEC[@]}" -- env PYTHONDONTWRITEBYTECODE=1 sh -s <<'REMOTE_CONNECTION' || true
set -u
cli() {
    if command -v timeout >/dev/null 2>&1 && timeout --version >/dev/null 2>&1; then
        timeout --signal=TERM --kill-after=1s 3s airflow "$@"
    else
        echo 'WARNING: remote timeout unavailable; only local kubectl deadline applies' >&2
        airflow "$@"
    fi
}
echo '>>> Получение effective remote_log_conn_id'
conn_id=$(cli config get-value logging remote_log_conn_id) || exit 1
# При примеси служебных сообщений берём последнюю непустую строку.
conn_id=$(printf '%s\n' "$conn_id" | awk 'NF {last=$0} END {print last}')
if [ -z "$conn_id" ]; then
    echo 'Connection ID пуст: возможен default AWS credential chain.'
    exit 0
fi
printf 'Connection ID: %s\n' "$conn_id"
echo '>>> Airflow connections get: чтение через штатный механизм Airflow'
raw=$(cli connections get "$conn_id" --output json) || {
    echo 'CONNECTION RESOLUTION FAILED; смотрите stderr выше.'
    exit 1
}
# Парсер JSON на AWK: только allowlist полей. Полный JSON, URI,
# description и произвольные значения extra никогда не выводятся.
printf '%s\n' "$raw" | awk '
function ws() { while (substr(s,p,1) ~ /[ \t\r\n]/ && p<=length(s)) p++ }
function str(    v,c,e) {
    if (substr(s,p++,1)!="\"") {bad=1;return ""}
    v=""
    while(p<=length(s)) {
        c=substr(s,p++,1)
        if(c=="\"")return v
        if(c=="\\") {
            e=substr(s,p++,1)
            if(e=="u") {p+=4;c="?"}
            else if(e=="n")c="\n"
            else if(e=="r")c="\r"
            else if(e=="t")c="\t"
            else c=e
        }
        v=v c
    }
    bad=1;return v
}
function emit(k,v,    a,b) {
    if(k ~ /^(login|password|aws_access_key_id|aws_secret_access_key|aws_session_token)$/) {
        print k ": present=" (v!="" && v!="null" ? "yes":"no") " length=" (v=="null" ? 0:length(v));seen++;return
    }
    if(k ~ /^(extra|extra_dejson)$/ && v ~ /^[ \t]*\{/) {
        a=s;b=p;s=v;p=1;value("extra");s=a;p=b;return
    }
    if(k ~ /^(conn_id|conn_type|host|port|schema|endpoint_url|region_name|profile_name|role_arn|verify|is_encrypted|is_extra_encrypted)$/) {
        gsub(/[\r\n\t]/," ",v)
        sub(/\/\/[^\/]*@/,"//<redacted>@",v)
        sub(/\?.*/,"?<redacted>",v)
        print k "=" v;seen++
    }
}
function value(k,    c,key,v) {
    ws();c=substr(s,p,1)
    if(c=="{") {
        p++;ws();if(substr(s,p,1)=="}"){p++;return}
        while(p<=length(s) && !bad) {
            ws();key=str();ws()
            if(substr(s,p++,1)!=":"){bad=1;return}
            value(key);ws();c=substr(s,p++,1)
            if(c=="}")return
            if(c!=","){bad=1;return}
        }
    } else if(c=="[") {
        p++;ws();if(substr(s,p,1)=="]"){p++;return}
        while(p<=length(s) && !bad) {
            value(k);ws();c=substr(s,p++,1)
            if(c=="]")return
            if(c!=","){bad=1;return}
        }
    } else if(c=="\"") {v=str();emit(k,v)}
    else {
        v="";while(p<=length(s) && substr(s,p,1) !~ /[ ,}\]\t\r\n]/)v=v substr(s,p++,1)
        if(v !~ /^(true|false|null|-?[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?)$/)bad=1
        else emit(k,v)
    }
}
{ data=data $0 "\n" }
END {
    s=data;p=1;ws()
    # CLI может добавить служебный stdout перед JSON; не печатаем его.
    if(match(s,/\[[ \t\r\n]*\{/))s=substr(s,RSTART)
    else if(match(s,/\{[ \t\r\n]*"/))s=substr(s,RSTART)
    p=1
    value("")
    if(bad || !seen) {print "ERROR: Connection JSON could not be parsed; raw output withheld";exit 1}
    print "CONNECTION RESOLVED: YES"
}'
REMOTE_CONNECTION

    # Фильтрация выполняется на мастере, после bounded kubectl logs.
    # pipefail сохраняет ошибки kubectl; весь pipeline в отдельной группе.
    FILTER='set -o pipefail; "$@" 2>&1 | awk '\''/NoCredentials|Unable to locate credentials|AccessDenied|InvalidAccessKey|SignatureDoesNotMatch|ExpiredToken|S3TaskHandler|s3_task_handler|Failed to upload|upload.*log|Could not write|Unable to upload|botocore|EndpointConnection|ConnectTimeout|ReadTimeout|Connection refused|Traceback|PermissionError|No space left/ {print; found=1} END {if(!found) print "No matching errors in sampled container logs; task-file logs may contain more"}'\'''
    run "$POD: ошибки отправки S3/credentials/network — текущий контейнер" \
        bash -c "$FILTER" diag "${LOGS[@]}" --since="$SINCE" --tail=3000 --limit-bytes=1048576 || true
    run "$POD: ошибки отправки — предыдущий контейнер" \
        bash -c "$FILTER" diag "${LOGS[@]}" --previous --tail=2000 --limit-bytes=1048576 || true

    run "$POD: ошибки S3 в локальных task-файлах (ограниченный поиск)" \
        "${EXEC[@]}" -- env PYTHONDONTWRITEBYTECODE=1 sh -c '
        if command -v timeout >/dev/null 2>&1 && timeout --version >/dev/null 2>&1; then
            exec timeout --signal=TERM --kill-after=1s 6s sh -s
        fi
        echo "SKIP: GNU timeout unavailable in container; recursive scan skipped"
        exit 1' <<'TASK_FILES' || true
set -u
echo '>>> Читаю effective base_log_folder'
base=$(airflow config get-value logging base_log_folder) || exit 1
base=$(printf '%s\n' "$base" | awk 'NF {last=$0} END {print last}')
if [ ! -d "$base" ]; then echo "ERROR: log directory unavailable: $base"; exit 1; fi
echo ">>> Ищу ошибки в *.log: $base; глубина до 6, последние 12 часов, до 120 совпадений"
# Весь поиск ограничен удалённым timeout, симлинки find не обходит.
# awk выходит после 120 совпадений. При отсутствии совпадений всё равно
# действует общий deadline поиска, это не полный аудит всех task-файлов.
find "$base" -maxdepth 6 -type f -name '*.log' -mmin -720 \
    -exec grep -nHE 'NoCredentials|Unable to locate credentials|AccessDenied|InvalidAccessKey|SignatureDoesNotMatch|ExpiredToken|Failed to upload|Unable to upload|Could not write|S3TaskHandler|s3_task_handler|EndpointConnection|ConnectTimeout|ReadTimeout|PermissionError|No space left' {} + \
    | awk 'NR<=120 {print} NR==120 {exit} END {if(NR==0)print "No matching errors found before scan completion; a timeout means incomplete search"}'
TASK_FILES

    run "$POD: окружение, конфиг, диск и права (shell внутри контейнера)" \
        "${EXEC[@]}" -- sh -s -- "$MINIO_HEALTH_URL" <<'REMOTE' || true
set -u
echo '--- Пользователь и hostname ---'
id
hostname
echo '--- Переменные: только наличие и длина ---'
env | awk '
  /^[A-Za-z_][A-Za-z0-9_]*=/ {
    p=index($0,"="); k=substr($0,1,p-1); v=substr($0,p+1)
    if (k ~ /^(AWS_|AIRFLOW_CONN_|AIRFLOW__LOGGING__)/ || k ~ /[Mm][Ii][Nn][Ii][Oo]/)
      printf "%s: present=%s length=%d\n",k,(length(v)>0 ? "yes":"no"),length(v)
  }'
echo '--- Настройки logging: выбранные поля из env ---'
for key in remote_logging remote_base_log_folder remote_log_conn_id base_log_folder logging_config_class delete_local_logs task_log_reader; do
    # Никаких eval и печати AIRFLOW_CONN_*.
    upper=$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')
    env | awk -v k="AIRFLOW__LOGGING__$upper" 'index($0,k"=")==1 { print $0 }'
done
cfg=${AIRFLOW_CONFIG:-${AIRFLOW_HOME:-/opt/airflow}/airflow.cfg}
echo "--- Конфиг: $cfg ---"
if [ -r "$cfg" ]; then
    awk '
      /^[[:space:]]*\[/ { in_logging=($0 ~ /^[[:space:]]*\[logging\]/) }
      in_logging && /^[[:space:]]*(remote_logging|remote_base_log_folder|remote_log_conn_id|base_log_folder|logging_config_class|delete_local_logs|task_log_reader)[[:space:]]*=/ { print }
    ' "$cfg"
else
    echo 'Конфиг недоступен; настройки могут приходить через env/Secrets.'
fi
echo 'Файл cfg и env не учитывают все overrides/Secrets backend; это не полный effective config.'
logs=${AIRFLOW__LOGGING__BASE_LOG_FOLDER:-}
if [ -z "$logs" ] && [ -r "$cfg" ]; then
    logs=$(awk '
      /^[[:space:]]*\[/ { section=($0 ~ /^[[:space:]]*\[logging\]/) }
      section && /^[[:space:]]*base_log_folder[[:space:]]*=/ {
        sub(/^[^=]*=[[:space:]]*/,""); sub(/[[:space:]]*$/,""); print; exit
      }' "$cfg")
fi
logs=${logs:-${AIRFLOW_HOME:-/opt/airflow}/logs}
echo "--- Каталог логов: $logs ---"
ls -ld "$logs" 2>&1
if [ -d "$logs" ]; then
    [ -r "$logs" ] && echo 'Readable=yes' || echo 'Readable=no'
    [ -w "$logs" ] && echo 'Writable=yes (проверка прав без создания файла)' || echo 'Writable=no'
    df -h "$logs" 2>&1
    df -i "$logs" 2>&1
    echo 'Содержимое верхнего уровня, до 25 строк; рекурсивного обхода нет:'
    ls -lt "$logs" 2>&1 | head -n 25
fi
echo '--- AWS-файлы: только метаданные ---'
for file in "${HOME:-/nonexistent}/.aws/credentials" "${HOME:-/nonexistent}/.aws/config" "${AWS_SHARED_CREDENTIALS_FILE:-}" "${AWS_CONFIG_FILE:-}"; do
    [ -n "$file" ] || continue
    if [ -e "$file" ]; then ls -ld "$file"; else printf '%s: отсутствует\n' "$file"; fi
done
if [ -n "$1" ]; then
    echo '--- MinIO health: HTTP GET без credentials, без записи ---'
    if command -v curl >/dev/null 2>&1; then
        curl --silent --show-error --connect-timeout 2 --max-time 3 \
            --output /dev/null --write-out 'HTTP=%{http_code}\n' "$1"
    else
        echo 'SKIP: curl отсутствует в контейнере.'
    fi
fi
REMOTE

    run "$POD: последние логи за $SINCE" "${LOGS[@]}" --since="$SINCE" --tail=200 --limit-bytes=262144 || true
    run "$POD: логи предыдущего контейнера (ошибка нормальна без рестарта)" \
        "${LOGS[@]}" --previous --tail=100 --limit-bytes=131072 || true
    run "$POD: события" "${KUBE[@]}" get events -n "$NS" \
        --field-selector "involvedObject.name=$POD" --sort-by=.lastTimestamp || true
done

echo
echo "Готово за $((SECONDS - START))s. Команд с ошибкой/таймаутом: $FAILURES."
echo 'Сравните настройки, env presence/length, mounts, образы, права/диск и ошибки загрузки логов.'
echo 'Доступность MinIO health не проверяет credentials и права PutObject.'
echo 'Connection читается штатным CLI Airflow внутри каждого worker; секретные значения скрыты.'
echo 'Источник AWS credentials дополнительно смотрите в env/profile/extra; S3Hook credential chain не исполняется.'
echo 'Права загрузки оцениваются по ошибкам уже происходивших отправок; пробных записей в S3 нет.'
echo 'Нет ошибки в выбранных stdout-логах — не доказательство успешной записи; ошибки могут быть в task-файлах.'
